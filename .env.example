# Google Analytics 4 — Measurement ID from analytics.google.com
# Admin → Data streams → your web stream → Measurement ID (starts with G-)
# Netlify → Site configuration → Environment variables → Production
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FXDKBZGJXX

# Cal.com — Book a demo / meeting (opens in a new tab from CTAs)
NEXT_PUBLIC_CAL_BOOKING_URL=https://cal.com/abdul-rehman/30min

# Optional product analytics (PostHog) — leave blank until you create a project
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional LLM observability (Langfuse) — use on app.arqonnect.io / workers, not this site
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
